{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1",
    "^cache/(.*)$": "<rootDir>/cache/$1",
    "^ioredis$": "<rootDir>/test/mocks/ioredis.mock.ts",
    "^@nestjs/bullmq$": "<rootDir>/test/mocks/bullmq.mock.ts",
    "^@stellar/stellar-sdk$": "<rootDir>/test/mocks/stellar-sdk.mock.ts",
    "^openai$": "<rootDir>/test/mocks/openai.mock.ts"
  }
}
