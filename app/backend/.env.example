DATABASE_URL="file:./prisma/dev.db"
WEBHOOK_SECRET="change-me-to-a-strong-random-secret"
SOROBAN_NETWORK="testnet"
AID_ESCROW_CONTRACT_ID=""
VERIFICATION_MODE="mock"

# Twilio SMS (leave blank to use the logging mock provider)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# SendGrid email (leave blank to use the logging mock provider)
SENDGRID_API_KEY=""
EMAIL_FROM_ADDRESS="no-reply@chainforge.local"
EMAIL_FROM_NAME="ChainForge"

# CSRF Protection (disabled by default; enable only when cookie-based auth is introduced)
# See docs/security/csrf-posture.md for current posture
CSRF_PROTECTION_ENABLED=false
