{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start",
      "url": [
        "http://localhost:3000/"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          { "minScore": 0.9 }
        ],
        "categories:best-practices": "warn",
        "categories:performance": "off",
        "categories:pwa": "off",
        "categories:seo": "off"
      }
    }
  }
}
